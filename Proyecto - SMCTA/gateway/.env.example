# Puerto del API Gateway
PORT=8080

# URL del servicio Backend Core (Rol 1) para proxy reverso
CORE_BACKEND_URL=http://localhost:3000

# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql://smcta_admin:smcta_secret_password@localhost:5432/smcta_db?schema=public

# Conexión a Caché Redis
REDIS_URL=redis://localhost:6379

# TTL de Caché de Tenants (en segundos)
TENANT_CACHE_TTL_SECONDS=300

# Dominio raíz base para resolución de subdominios
ROOT_DOMAIN=smcta.local
