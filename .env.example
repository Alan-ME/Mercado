# SMCTA P2P v2 — Variables de entorno (todas opcionales)
# Sin definir ninguna, el sistema levanta directo con F5 usando PostgreSQL embebido (PGlite)
# y locks en proceso con desalojo por TTL.

PORT=8080
LOG_LEVEL=info

# Orígenes CORS permitidos separados por coma (además de localhost y *.smcta.local en dev)
# CORS_ORIGINS=https://portal.cliente-b2b.ar

# Habilita selectores demo (/api/v1/dev/*). En producción poner en false.
# ENABLE_DEV_ROUTES=true

# Secreto HMAC-SHA256 opcional para autenticar x-psp-signature en /api/v1/escrow/webhook-release
# PSP_WEBHOOK_SECRET=

# Adaptadores de red (pg e ioredis ya vienen instalados en @smcta/backend)
# DATABASE_URL=postgresql://smcta:smcta@localhost:5432/smcta
# REDIS_URL=redis://localhost:6379
