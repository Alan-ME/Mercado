# ─────────────────────────────────────────────────────────────
# SMCTA · Variables de entorno (todas OPCIONALES)
# Sin ninguna de estas, el proyecto arranca con F5 usando PostgreSQL
# embebido (PGlite) y locks en proceso. Cero setup externo.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (backend + frontend servido en el mismo proceso)
PORT=8080

# Nivel de log de Fastify: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# --- Ruta "documentada" (PostgreSQL 15+ en red) ---
# Si se define, se usa `pg` en lugar de PGlite. Requiere: npm i pg
# DATABASE_URL=postgresql://smcta:smcta@localhost:5432/smcta

# --- Locks distribuidos con Redis (multi-instancia) ---
# Si se define, se usa `ioredis`. Requiere: npm i ioredis
# REDIS_URL=redis://localhost:6379

# Ruta al build del frontend (por defecto: apps/web/dist)
# WEB_DIST_PATH=
